---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { currentStudy } from "../../lib/auth";
import { nextStudyPath } from "../../lib/flow";
import { getSession } from "../../lib/store";

const study = await currentStudy(Astro.request);
if (!study) return Astro.redirect("/");
if (!study.sessionId) return Astro.redirect("/study/offer");

const session = await getSession(study.sessionId);
if (!session) return Astro.redirect("/study/offer");
if (session.phase !== "grammar") return Astro.redirect(await nextStudyPath(study));

const same = session.soloOriginal.trim() === session.grammarDraft.trim();
---

<BaseLayout title="Lock — Dyad">
  <SiteHeader />
  <main class="mx-auto max-w-2xl px-6 py-12">
    <p class="text-sm uppercase tracking-[0.18em] text-muted-foreground">Grammar pass</p>
    <h1 class="mt-2 font-serif text-4xl tracking-tight">Lock a version</h1>
    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
      Spelling and grammar were corrected. Meaning should be unchanged. Lock a version only when you
      are happy with it — you can still go back and edit.
    </p>

    {
      same ? (
        <section class="mt-8 rounded-2xl border border-border bg-card p-5">
          <p class="whitespace-pre-wrap text-sm leading-relaxed">{session.soloOriginal}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <form method="post" action="/api/lock">
              <input type="hidden" name="choice" value="original" />
              <button
                class="rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground"
                type="submit"
              >
                Lock this draft
              </button>
            </form>
            <form method="post" action="/api/lock">
              <input type="hidden" name="action" value="edit" />
              <button class="rounded-lg border border-border px-5 py-2.5 text-sm" type="submit">
                Go back and edit
              </button>
            </form>
          </div>
        </section>
      ) : (
        <>
          <div class="mt-8 grid gap-4 md:grid-cols-2">
            <section class="rounded-2xl border border-border bg-card p-5">
              <h2 class="text-sm font-medium uppercase tracking-wide text-muted-foreground">Original</h2>
              <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed">{session.soloOriginal}</p>
              <form class="mt-6" method="post" action="/api/lock">
                <input type="hidden" name="choice" value="original" />
                <button class="rounded-lg border border-border px-4 py-2 text-sm" type="submit">
                  Lock original
                </button>
              </form>
            </section>
            <section class="rounded-2xl border border-primary bg-card p-5">
              <h2 class="text-sm font-medium uppercase tracking-wide text-muted-foreground">
                Grammar edit
              </h2>
              <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed">{session.grammarDraft}</p>
              <form class="mt-6" method="post" action="/api/lock">
                <input type="hidden" name="choice" value="grammar" />
                <button
                  class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
                  type="submit"
                >
                  Lock edited version
                </button>
              </form>
            </section>
          </div>
          <form class="mt-6" method="post" action="/api/lock">
            <input type="hidden" name="action" value="edit" />
            <button class="rounded-lg border border-border px-5 py-2.5 text-sm" type="submit">
              Go back and edit
            </button>
          </form>
        </>
      )
    }
  </main>
</BaseLayout>
