---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import ScaleField from "../../components/ScaleField.astro";
import { currentStudy } from "../../lib/auth";
import { nextStudyPath } from "../../lib/flow";
import { getSession } from "../../lib/store";

const study = await currentStudy(Astro.request);
if (!study) return Astro.redirect("/");
if (!study.sessionId) return Astro.redirect("/study/offer");

const session = await getSession(study.sessionId);
if (!session) return Astro.redirect("/study/offer");
if (session.phase !== "solo_rate") return Astro.redirect(await nextStudyPath(study));
---

<BaseLayout title="Rate your draft — Dyad">
  <SiteHeader />
  <main class="mx-auto max-w-2xl px-6 py-12">
    <p class="text-sm uppercase tracking-[0.18em] text-muted-foreground">Locked solo piece</p>
    <h1 class="mt-2 font-serif text-4xl tracking-tight">How is this version?</h1>
    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
      Rate the quality of the locked draft (x) and how writing it felt (x′).
    </p>

    <section class="mt-8 rounded-2xl border border-border bg-card p-5">
      <p class="whitespace-pre-wrap text-sm leading-relaxed">{session.lockedSolo}</p>
    </section>

    <form class="mt-8 space-y-8" method="post" action="/api/solo-rate">
      <ScaleField
        name="Quality of the piece (x)"
        field="quality"
        value={session.soloQuality}
        labels={["Weak", "Strong"]}
        required
      />
      <ScaleField
        name="How writing it felt (x′)"
        field="experience"
        value={session.soloExperience}
        labels={["Frustrating", "Absorbing"]}
        required
      />
      <button
        class="rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground"
        type="submit"
      >
        Continue
      </button>
    </form>
  </main>
</BaseLayout>
