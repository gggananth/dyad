GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
WORD_LIMIT=75
PAIRING_MIN_MS=4000
PAIRING_MAX_MS=12000
LIVE_WITHIN_MS=150000
NOTICE_EVERY_MS=60000
LAB_ADMIN_PASSWORD=

# PlanetScale Postgres (app traffic: port 6432 / PgBouncer)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6432/dyad?sslmode=verify-full
# Migrations / psql (port 5432, direct)
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST:5432/dyad?sslmode=verify-full&sslrootcert=system&sslnegotiation=direct

